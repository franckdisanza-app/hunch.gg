# Every environment variable Plimp reads. For local development copy this file to .env.local
# (never commit .env.local). On Vercel, set them under Project → Settings → Environment Variables.

# Canonical origin for share links, Open Graph, canonical URLs and the sitemap, e.g. https://plimp.lol.
# Unset: the Vercel deployment URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Supabase project URL (Dashboard → Settings → API Keys, or set by the Vercel Marketplace integration).
SUPABASE_URL=
# Supabase secret key (sb_secret_…). Server only: it bypasses row-level security. Never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Long random string. Rate limiting uses sha256(ip + IP_HASH_SALT + date). Required in production.
IP_HASH_SALT=
# Long random string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>" to /api/cron/freeze.
CRON_SECRET=

# "memory": in-process crowd store for local development without Docker and for e2e tests.
# Leave empty to use Supabase. Refused on Vercel production.
CROWD_STORE=

# Analytics provider: none | plausible | umami | vercel. Loads only in production builds, never on
# Vercel preview deployments. All four are cookieless. See docs/DEPLOY.md before picking vercel.
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
# Plausible: the site's domain as registered in Plausible, e.g. plimp.lol.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Plausible: script URL. Default https://plausible.io/js/script.js; use the one Plausible shows you.
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=
# Umami: website ID from the Umami dashboard.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Umami: script URL. Default https://cloud.umami.is/script.js.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
# Umami: origin that receives events, only if it differs from the script's origin.
NEXT_PUBLIC_UMAMI_HOST_URL=

# "production" makes content:validate reject anything flagged sample: true. Set it for Vercel
# Production only; leave empty elsewhere so sample content can be used while building a game.
CONTENT_MODE=

# "1" makes /dev and unreleased (hidden, coming-soon) games available in a production build.
# Useful on Preview deployments; never set it on Production.
ENABLE_DEV_ROUTES=

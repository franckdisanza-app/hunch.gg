{
  "name": "plimp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm content:validate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "content:validate": "tsx scripts/validate-content.ts",
    "new-game": "tsx scripts/new-game.ts",
    "csv-to-json": "tsx scripts/csv-to-json.ts",
    "sticker-shock:build": "tsx scripts/sticker-shock/build.ts",
    "sticker-shock:sample": "tsx scripts/sticker-shock/make-sample.ts",
    "sticker-shock:art": "tsx scripts/sticker-shock/art.tsx",
    "sticker-shock:proofs": "tsx scripts/sticker-shock/proofs.ts",
    "sticker-shock:open-prices": "tsx scripts/sticker-shock/open-prices.ts",
    "sticker-shock:accuracy": "tsx scripts/sticker-shock/accuracy.ts",
    "size": "tsx scripts/check-bundle-size.ts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/supabase/types.ts && prettier --write src/lib/supabase/types.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "d3-geo": "^3.1.1",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/topojson-client": "^3.1.5",
    "eslint": "^10.11.0",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "flag-icons": "^7.5.0",
    "geokdbush": "^2.1.0",
    "jsdom": "^30.1.1",
    "kdbush": "^4.1.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.118.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.2"
  }
}
